DATABASE_URL=postgresql+psycopg://workos:workos@localhost:5432/workos
# At least 32 random characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=https://your-frontend-domain.example
# Keep false. Turn on only while creating your own account, or use `python manage.py create-user`.
ALLOW_REGISTRATION=false
ACCESS_TOKEN_TTL_MINUTES=720
# Real client IP for rate limiting behind a proxy. Leave empty when clients connect directly.
# Use CLIENT_IP_HEADER for an edge-set header (e.g. CF-Connecting-IP) or TRUSTED_PROXY_HOPS=N for X-Forwarded-For.
CLIENT_IP_HEADER=
TRUSTED_PROXY_HOPS=0
LOG_LEVEL=INFO
